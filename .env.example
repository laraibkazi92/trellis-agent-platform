GEMINI_API_KEY=your_gemini_api_key_here
PUBLIC_HOST_URL=http://localhost:8000
PUBLIC_MCP_URL=http://localhost:8002/mcp
ADMIN_USERS=dev-user@local.host
DEV_MODE=false
SESSION_SECRET=your_random_session_secret_here

# Authentication (Optional - if none are provided, DEV_MODE=true is recommended for local testing)
# GitHub Provider
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# OIDC Provider
# OIDC_CLIENT_ID=your_oidc_client_id
# OIDC_CLIENT_SECRET=your_oidc_client_secret
# OIDC_METADATA_URL=https://your-idp.example.com/.well-known/openid-configuration

# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_REPORT_CHANNEL_ID=your_private_channel_id

# Gateway & SSL Configuration
# Set to True/true to enable HTTPS. If true, you must provide certificates.
SSL_ENABLED=False

# The domain name to use in the Nginx server block (e.g., your-domain.com or localhost)
SSL_DNS_NAME=localhost

# Directory containing your SSL certificates (must contain cert.pem and key.pem)
# If using docker-compose, uncomment the volume mount in docker-compose.yml to use this.
SSL_CERT_DIR=./gateway/ssl

# Whitelabel & Branding Configuration (Optional)
# APP_NAME="Agent Framework"
# APP_FAVICON_URL=""
# APP_LOGO_URL=""
# APP_LOGIN_LOGO_URL=""
# APP_LOGIN_TITLE="Welcome Back"
# APP_LOGIN_SUBTITLE="Sign in to your enterprise workspace"
# APP_LOGIN_DISCLAIMER="This system is for authorized use only. All activities are monitored and logged for security and compliance purposes."
# APP_ACCENT_COLOR="#0055FF"
# APP_ACCENT_COLOR_DARK="#3377FF"
