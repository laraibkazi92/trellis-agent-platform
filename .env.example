# ==============================================================================
# Core Framework Configuration
# ==============================================================================
# This file holds bootstrap, infrastructure and secret values that must exist before
# the services can start. Runtime/operational settings — the Rules Engine (model,
# provider, base_url, timeout, confidence), operational limits & timeouts (Limits &
# Tuning), feature flags, and branding — live in the Admin Dashboard and are stored in
# etcd. The env vars noted below are only optional defaults for those settings; set them
# to seed a fresh deployment, or set the values in the UI (preferred, and changeable
# without a restart).
# Framework LLM provider keys (for agents, the Rules Engine, and agent embeddings) are NOT
# read from the environment. Set them in the Admin UI -> Global Tool Configuration; they are
# stored Fernet-encrypted in etcd. An unset key simply disables that provider until set.
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEY above is consumed ONLY by the Hindsight memory container (as the fallback
# for HINDSIGHT_LLM_API_KEY — see the Agent Memory section below). It is not read for agent
# LLM calls, which use the keys configured in the Admin UI.
# Public URLs shown in the UI. Optional defaults; edit in Admin Dashboard -> Limits & Tuning.
PUBLIC_HOST_URL=http://localhost:8000
PUBLIC_MCP_URL=http://localhost:8002/mcp
ADMIN_USERS=dev-user@local.host
# WARNING: DEV_MODE=true disables ALL authentication (API keys, UI login, MCP auth)
# across host/hub/gateway/ui. Dev hosts are not the deployment target and dev instances
# are often reached from other machines, so this only logs a startup warning -- it does
# NOT restrict the bind host. Never expose a DEV_MODE instance to production.
DEV_MODE=false
# HOST_BIND=0.0.0.0                # Host address published ports bind to (docker-compose
#                                  #  port mappings, e.g. nginx 80/443). Default 0.0.0.0.
#                                  #  Direct runs (python core/hub.py / core/gateway.py)
#                                  #  use BIND_HOST as their actual bind.
# DEV_USER_EMAIL=dev-user@local.host
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ==============================================================================
# Deployment Layout (docker-compose)
# ==============================================================================
# Every app service bind-mounts the workspace at /app/workspace. By default that is
# ./workspace inside this clone. To keep the framework (engine) and your agents/tools
# (content) in separate repos, point this at your own content checkout instead -- the
# engine clone then stays pristine and can be re-pulled at a release tag without ever
# merging your content. See docs/deploy.md.
# TRELLIS_WORKSPACE_DIR=./workspace      # e.g. ../my-org-workspace (relative paths
#                                        # resolve from this clone's directory)
# Image the compose services run. The default is the released multi-arch image on
# GHCR (pulled, not built). Override to build from source, or pin a digest for an
# immutable deploy. `docker compose up -d --build` ignores this and builds locally.
# TRELLIS_IMAGE=ghcr.io/laraibkazi92/trellis-agent-platform:v0.2.0
# Registry-sync prune guard escape hatch (db-sync service only). The sync refuses to
# prune when the workspace syncs nothing at all (it looks unmounted); set this to true
# only for a rebuild that genuinely removes all workspace content.
# SYNC_FORCE_PRUNE=false

# ==============================================================================
# Tool Hub Sandbox (docker-compose)
# ==============================================================================
# The hub container runs least-privilege instead of privileged: all Linux
# capabilities are dropped except SYS_ADMIN + SETFCAP — the minimum bwrap
# (core/hub.py) needs to create its per-tool user namespace and map root into
# it — plus no-new-privileges and unmasked system paths (docker's masked /proc
# would make the kernel reject bwrap's fresh proc mount). Nothing to set here;
# this is documented for operators. If tool execution fails with bwrap/userns
# errors on your host (exotic kernels, hardened seccomp policies), you can
# restore the old behavior locally by replacing the hub's
# cap_drop/cap_add/security_opt block in docker-compose.yml with
# `privileged: true` (much broader container access).

# Secrets & Session Encryption
SESSION_SECRET=your_random_session_secret_here
# ENCRYPTION_KEY=your_fernet_encryption_key_here  # Falls back to SESSION_SECRET if unset

# ==============================================================================
# Health Monitor & Circuit Breaker
# ==============================================================================
# Optional defaults; edit in Admin Dashboard -> Limits & Tuning.
# HEALTH_FAILURE_THRESHOLD=10    # Consecutive failures before tripping to Offline
# HEALTH_COOLDOWN_SECONDS=60     # Seconds to wait before attempting Half-Open probe

# ==============================================================================
# Workflow & Task Execution Limits
# ==============================================================================
# Optional defaults; edit in Admin Dashboard -> Limits & Tuning.
# MAX_RUN_OUTPUT_CHARS=32768     # Max stdout/stderr size stored in etcd (32 KB)
# MAX_RUN_ERROR_CHARS=4096       # Max error trace size stored in etcd (4 KB)
# TOOL_EXECUTION_TIMEOUT=300     # Seconds before a hub tool subprocess is killed
# TOOL_SEARCH_LIMIT=8            # Max tools returned by search_tools
# FRAMEWORK_REGISTRY_REFRESH_TIMEOUT=5    # Bounded wait (s) for on-demand supervisor snapshot refresh
# FRAMEWORK_REGISTRY_SNAPSHOT_TTL=15      # Seconds between background supervisor snapshot refreshes

# ==============================================================================
# Agent Memory (Hindsight) & Semantic Search
# ==============================================================================
# Agent Memory (Hindsight). URL of the Hindsight server. In docker-compose this is set
# automatically to http://hindsight:8888. The feature is gated by the admin
# 'Agent Memory' feature flag (Admin Dashboard) and per-agent 'agent_memory: true' config.
HINDSIGHT_URL=http://hindsight:8888

# Which LLM Hindsight uses for fact extraction / reflection. Defaults to Gemini using the
# GEMINI_API_KEY at the top of this file — Hindsight is the ONLY consumer of that env var,
# since agent/rules/embeddings keys now live in the Admin UI (etcd). Override the model here
# (e.g. gemini-2.5-pro), or switch providers (provider one of: gemini, openai, anthropic,
# groq, ...) and set HINDSIGHT_LLM_API_KEY.
# HINDSIGHT_LLM_PROVIDER=gemini
# HINDSIGHT_LLM_MODEL=gemini-2.5-flash
# HINDSIGHT_LLM_API_KEY=                      # falls back to GEMINI_API_KEY if unset
# HINDSIGHT_EMBEDDINGS_PROVIDER=google        # provider for Gemini embeddings is "google", not "gemini"
# HINDSIGHT_EMBEDDINGS_MODEL=gemini-embedding-2   # multimodal; or gemini-embedding-001 (text-only)
# Output embedding dimension (Matryoshka). gemini-embedding-2 supports 128–3072
# (recommended 768 / 1536 / 3072) and auto-normalizes truncated dimensions.
# IMPORTANT: set this BEFORE first use — changing the model OR dimension later requires wiping
# the hindsight-data volume
# (`docker compose down && docker volume rm "$(basename "$PWD")_hindsight-data"`), or recall
# breaks on a mismatch. Do NOT use `down -v` — it also deletes the etcd-data volume.
# HINDSIGHT_EMBEDDINGS_DIMENSIONS=768
# Reranker. The slim image ships no local cross-encoder, so 'local' (the default) fails.
# Use 'rrf' (Reciprocal Rank Fusion passthrough — no neural rerank, no extra key/cost), or
# point at an API reranker (cohere / google-vertex / etc.) with its own credentials.
# HINDSIGHT_RERANKER_PROVIDER=rrf
# Semantic agent discovery (search_agents / auto_select). Agents are indexed at sync time
# using Gemini embeddings (configured in the Admin UI -> Global Tool Configuration). If
# unavailable, search falls back to keyword matching. AGENT_SEARCH_LIMIT caps how many
# agents search_agents returns.
# Optional defaults; edit in Admin Dashboard -> Limits & Tuning.
# WARNING: changing AGENT_EMBEDDING_MODEL invalidates previously stored embeddings —
# re-embed agents (rebuild / registry sync) before semantic search works again.
# AGENT_SEARCH_LIMIT=8
# AGENT_EMBEDDING_MODEL=gemini-embedding-001

# ==============================================================================
# Authentication Providers (Optional)
# ==============================================================================
# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# OIDC OIDC
# OIDC_CLIENT_ID=your_oidc_client_id
# OIDC_CLIENT_SECRET=your_oidc_client_secret
# OIDC_METADATA_URL=https://your-idp.example.com/.well-known/openid-configuration

# Allowed Email Domains (comma-separated, leave blank for any domain)
ALLOWED_DOMAINS=

# ==============================================================================
# Notifications & 3rd Party Integrations
# ==============================================================================
# 3rd-party credentials (e.g. SLACK_BOT_TOKEN) are NOT configured here. Store them
# as Tool Secrets in the UI (Configuration), which injects them into tool/workflow
# subprocesses at run time via the identity-scoped secret store. See docs/tools.md.

# ==============================================================================
# Container Runtime User (docker-compose only)
# ==============================================================================
# The app containers run as this uid:gid so files they write into the bind-mounted
# workspace/ (editor saves, marketplace adds, generated reports) are owned by you, not
# root. Set to your host user:  TRELLIS_UID=$(id -u)  TRELLIS_GID=$(id -g)
# Defaults to 1000:1000. After changing it, rebuild (`docker compose up -d --build`).
# If the health-data volume already exists root-owned, remove ONLY that volume and
# recreate (`docker compose down && docker volume rm "$(basename "$PWD")_health-data"`);
# do NOT use `down -v`, which also deletes the etcd-data volume (users, API keys,
# run history). The hub service stays root on purpose (bubblewrap sandbox).
# TRELLIS_UID=1000
# TRELLIS_GID=1000

# ==============================================================================
# Service Topology (docker-compose sets these; needed for direct runs)
# ==============================================================================
# Internal service discovery. compose overrides HOST_URL/HUB_URL/REDIS_URL per
# container; set them here only when running a service directly (python core/*.py).
# ETCD_HOST=127.0.0.1
# ETCD_PORT=2379
# REDIS_URL=redis://localhost:6379/0
# HOST_URL=http://localhost:8000
# HUB_URL=http://localhost:8001/mcp

# ==============================================================================
# Rules Engine (Admin Dashboard -> Trellis Rules Engine)
# ==============================================================================
# The decider model/provider/base_url/timeout/confidence are configured in the admin
# UI and stored in etcd. These env vars are optional defaults used until an override
# is set (or when the etcd override lookup fails).
# RULES_EVALUATION_MODEL=gemini-2.5-flash
# RULES_EVALUATION_PROVIDER=            # e.g. google, openai, anthropic, openai-compatible
# RULES_EVALUATION_BASE_URL=            # for openai-compatible
# RULES_EVALUATION_TIMEOUT=2.5
# RULES_CONFIDENCE_THRESHOLD=0.8

# ==============================================================================
# Gateway & SSL Configuration
# ==============================================================================
# Set to True/true to enable HTTPS. If true, you must provide certificates.
SSL_ENABLED=False

# The domain name to use in the Nginx server block (e.g., your-domain.com or localhost)
SSL_DNS_NAME=localhost

# Directory containing your SSL certificates (must contain cert.pem and key.pem)
# If using docker-compose, uncomment the volume mount in docker-compose.yml to use this.
SSL_CERT_DIR=./gateway/ssl

# ==============================================================================
# Whitelabel & Branding
# ==============================================================================
# Edit these in the Admin Dashboard -> Branding. The APP_* vars below are only the
# built-in defaults a deployment may seed; an unset var falls back to the value shown.
# APP_NAME="Trellis"
# APP_FAVICON_URL=""
# APP_LOGO_URL=""
# APP_LOGIN_LOGO_URL=""
# APP_LOGIN_TITLE="Welcome Back"
# APP_LOGIN_SUBTITLE="Sign in to your workspace"
# APP_LOGIN_DISCLAIMER="This system is for authorized use only. All activities are monitored and logged for security and compliance purposes."
# APP_ACCENT_COLOR="#0055FF"
# APP_ACCENT_COLOR_DARK="#3377FF"
