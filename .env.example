GEMINI_API_KEY=your_gemini_api_key_here
PUBLIC_HOST_URL=http://localhost:8000
PUBLIC_MCP_URL=http://localhost:8002/mcp
ADMIN_USERS=dev-user@local.host
DEV_MODE=false
SESSION_SECRET=your_random_session_secret_here

# Authentication (Optional - if none are provided, DEV_MODE=true is recommended for local testing)
# GitHub Provider
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# OIDC Provider
OIDC_CLIENT_ID=your_oidc_client_id
OIDC_CLIENT_SECRET=your_oidc_client_secret
OIDC_METADATA_URL=https://your-idp.example.com/.well-known/openid-configuration
