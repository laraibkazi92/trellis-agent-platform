# ==============================================================================
# Core Framework Configuration
# ==============================================================================
# This file holds bootstrap, infrastructure and secret values that must exist before
# the services can start. Runtime/operational settings — the Rules Engine (model,
# provider, base_url, timeout, confidence), operational limits & timeouts (Limits &
# Tuning), feature flags, and branding — live in the Admin Dashboard and are stored in
# etcd. The env vars noted below are only optional defaults for those settings; set them
# to seed a fresh deployment, or set the values in the UI (preferred, and changeable
# without a restart).
# Framework LLM provider keys (for agents, the Rules Engine, and agent embeddings) are NOT
# read from the environment. Set them in the Admin UI -> LLM Providers; they are
# stored Fernet-encrypted in etcd. An unset key simply disables that provider until set.
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEY above is consumed ONLY by the Hindsight memory container (as the fallback
# for HINDSIGHT_LLM_API_KEY — see the Agent Memory section below). It is not read for agent
# LLM calls, which use the keys configured in the Admin UI.
# Public URLs shown in the UI. Optional defaults; edit in Admin Dashboard -> Limits & Tuning.
PUBLIC_HOST_URL=http://localhost:8000
PUBLIC_MCP_URL=http://localhost:8002/mcp
ADMIN_USERS=dev-user@local.host
# WARNING: DEV_MODE=true disables ALL authentication (API keys, UI login, MCP auth)
# across host/hub/gateway/ui. Dev hosts are not the deployment target and dev instances
# are often reached from other machines, so this only logs a startup warning -- it does
# NOT restrict the bind host. Never expose a DEV_MODE instance to production.
DEV_MODE=false
# HOST_BIND=0.0.0.0                # Host address published ports bind to (docker-compose
#                                  #  port mappings, e.g. nginx 80/443). Default 0.0.0.0.
#                                  #  Direct runs (python core/hub.py / core/gateway.py)
#                                  #  use BIND_HOST as their actual bind.
# DEV_USER_EMAIL=dev-user@local.host
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ------------------------------------------------------------------------------
# trellis-proxy (edge nodes) -- DEV ONLY
# ------------------------------------------------------------------------------
# A local edge node (deploy/proxy/) normally authenticates with a token issued for a
# pre-registered site. For a single-host dev loop the relay also accepts one fixed
# site/token pair, so you can run a proxy without creating an enrollment record.
# WARNING: both values are IGNORED unless DEV_MODE=true above. Never set them on a
# shared or production host -- this token has no rotation, no revocation, and no audit
# trail, and it is compared in plaintext.
# EDGE_DEV_SITE=dev-edge
# EDGE_DEV_TOKEN=dev-edge-token

# Per-site call budget for the relay (a site record can override it) and the
# connection-level flood limit nginx applies to /edge.
# EDGE_RATE_LIMIT_PER_MIN=120
# EDGE_RATE_LIMIT_RPS=30
# EDGE_RATE_LIMIT_BURST=20
# Optional mutual TLS for edge nodes: CA bundle inside the nginx container. Requires
# SSL_ENABLED=true and the SSL volume uncommented in docker-compose.yml. Note this is
# fail-loud: a wrong path stops nginx (and therefore the UI/API), not just /edge.
# EDGE_MTLS_CA=/etc/nginx/ssl/edge-ca.pem
# Where the relay's audit trail lives (inside the health-data volume, 10 MB x 5).
# EDGE_AUDIT_LOG=/app/data/edge-audit.log
# How often the hub re-reads the registry for relay-published tools. 0 disables it.
# EDGE_TOOL_RECONCILE_SECONDS=10
# Override the hub -> relay address (compose sets it from the service name). Only
# relevant for a non-compose install that splits the services onto different hosts.
# EDGE_RELAY_URL=http://edge-relay:8100
# Version reported by the edge hello frame in Admin -> Edges. Compose passes the value
# used for the build; the release workflow passes the published tag.
# TRELLIS_VERSION=v0.4.0

# ==============================================================================
# Deployment Layout (docker-compose)
# ==============================================================================
# Every app service bind-mounts the workspace at /app/workspace. By default that is
# ./workspace inside this clone. To keep the framework (engine) and your agents/tools
# (content) in separate repos, point this at your own content checkout instead -- the
# engine clone then stays pristine and can be re-pulled at a release tag without ever
# merging your content. See docs/deploy.md.
# TRELLIS_WORKSPACE_DIR=./workspace      # e.g. ../my-org-workspace (relative paths
#                                        # resolve from this clone's directory)
# Image the compose services run. The default is the released multi-arch image on
# GHCR (pulled, not built). Override to build from source, or pin a digest for an
# immutable deploy. `docker compose up -d --build` ignores this and builds locally.
# TRELLIS_IMAGE=ghcr.io/laraibkazi92/trellis-agent-platform:v0.7.1
# Registry-sync prune guard escape hatch (db-sync service only). The sync refuses to
# prune when the workspace syncs nothing at all (it looks unmounted); set this to true
# only for a rebuild that genuinely removes all workspace content.
# SYNC_FORCE_PRUNE=false

# ==============================================================================
# Tool Execution
# ==============================================================================
# There is no sandbox backend selector: every tool call and MCP stdio session runs
# in its own container created by the `runner` service (see "Execution Isolation
# Runner" below). The legacy in-process backends (bwrap, Landlock, AppArmor
# profiles), the network profiles and the egress proxy were removed in v0.7.1 --
# nothing here needs tuning for them. See docs/upgrading.md.
#
# Per-manifest `network:` is one of:
#   egress  Docker's default bridge: the container can reach whatever the host can
#           (default for tools, MCP sessions and workflows)
#   none    no network at all (`execute` always uses this)
# Legacy values `allow`, `internet` and `internal` are accepted as `egress` and log
# one deprecation warning per value; rewrite the manifest to silence it.

# ==============================================================================
# Execution Isolation Runner (v0.6)
# ==============================================================================
# The `runner` service is the only component with /var/run/docker.sock. It creates
# one gVisor container per tool call and exposes a control API on a Unix socket
# (never a TCP port). Requires `runsc` registered with the host Docker daemon --
# see docs/deploy.md ("Execution isolation").
# Control API socket path, shared through the `runner-run` volume with host, hub,
# gateway and taskiq-worker. Compose defaults it; only set it to move the socket.
# RUNNER_SOCKET=/run/trellis/runner.sock
# REQUIRED bearer token for the runner API. Generate a fresh value per install and
# set the SAME value on the runner and every caller (compose refuses to start while
# it is empty):
#   openssl rand -hex 32
# The runner refuses to start without it (unless DEV_MODE=true, which logs a warning
# and accepts unauthenticated calls on the socket). ";"-separated values are not
# supported here yet -- rotate by restarting the runner and callers together.
RUNNER_TOKEN=
# TRELLIS_HOST_WORKSPACE: REQUIRED. The HOST path of the directory you mount as
# /app/workspace (the same files as TRELLIS_WORKSPACE_DIR). Docker resolves every
# tool bind mount against it, and the runner refuses to serve when a startup canary
# proves the path is wrong. Compose stops with an error when it is unset; use an
# absolute path:
# TRELLIS_HOST_WORKSPACE=/opt/trellis/workspace
# Runtime for a manifest that omits `container_runtime`: runsc (gVisor) | runc.
# Default `runsc`, which is the isolation boundary in production. On a dev machine
# without gVisor set `runc` for the whole install; a per-tool `container_runtime:
# runc` forfeits kernel-syscall isolation and must be justified per tool.
# CONTAINER_DEFAULT_RUNTIME=runsc
# Image every tool container starts from. Must already exist locally -- the runner
# never pulls. Defaults to TRELLIS_IMAGE (or the same default as the services).
# Must be v0.7.1 or newer: every container starts through /usr/local/bin/trellis-exec,
# which older images do not have -- with one of those, no tool container can start at
# all and the runner's canary refuses to serve. Rebuild or re-pull after upgrading.
# RUNNER_IMAGE=ghcr.io/laraibkazi92/trellis-agent-platform:v0.7.1
# Capacity: global concurrent containers, per-tool concurrent containers, and the
# orphan-sweep interval (seconds). Exceeding capacity returns 429 (retryable).
# RUNNER_MAX_CONTAINERS=32
# RUNNER_MAX_CONTAINERS_PER_TOOL=8
# RUNNER_REAP_INTERVAL_S=300
# gid of the host's docker group. Only needed by the runner service's group_add (it
# runs as root and needs the socket); set it when the socket is not root-readable.
# DOCKER_GID=999
# `runsc` binary the runner's non-fatal gVisor version check asks (`--version`). Only
# meaningful when the binary is visible inside the runner: gVisor is a HOST runtime, the
# shipped compose files mount no `runsc` into it, and the check then reports itself as
# skipped. Confirm the version on the host instead (docs/deploy.md -> Prerequisite:
# gVisor); set this only for a deployment that mounts the binary.
# RUNSC_BIN=runsc
# Install id stamped on every tool container as label `trellis.install=<id>`, so
# orphan sweeps and `docker ps --filter label=trellis.install` cannot mistake two
# installs for each other. Defaults to `default`.
# TRELLIS_INSTALL_ID=trellis-prod
# HMAC key for the short-lived agent tokens that carry (agent, user, run, groups,
# expiry). REQUIRED from v0.6 phase 3 on the CENTRAL services: host, hub, gateway,
# taskiq-worker, edge-relay and the central runner verify tokens and refuse to serve
# without a key (DEV_MODE=true is the only exception). Since v0.7.2 NO edge service
# holds this key: the relay is the only verifier on the edge path, the edge proxy
# forwards the identity it derived, and the edge runner (RUNNER_ROLE=edge) takes that
# identity over the runner-token-authenticated socket. `;`-separated values are a
# rotation list (sign with the first, verify with any), so start a rotation by
# prepending the new key. At least 32 bytes:
#   AGENT_TOKEN_SECRET=$(openssl rand -hex 32)
# AGENT_TOKEN_SECRET=
# Server-side allowlist enforcement: enforce | log | off. `enforce` (the code default)
# refuses a call with no/forged/expired token, or a tool/MCP reference outside the
# agent's effective allowlist (403 access_denied). `log` records the would-be denial
# and permits it -- the one-release rollout window after upgrading. `off` is a
# local-development posture only: it requires DEV_MODE=true and is otherwise refused
# (an error is logged and `enforce` applies), because a stack that forgot this knob
# must not run unauthenticated. An EDGE deployment assumes `enforce`: the relay derives
# the call's whole identity from the token it verifies, so with `off` (or `log` and a
# rejected token) there is no identity to forward and the edge answers 400.
# ENFORCE_AGENT_TOKENS=enforce
# Tool-access group rules: off | shadow | enforce (default `enforce`). Governs the
# group rules from workspace/policies/tool_access.yaml -- NOT the per-agent allowlist,
# which is always enforced. `shadow` logs and records what it would deny (admin page
# shows the recent records) and permits the call; `off` skips the group rules
# entirely. An unrecognized value logs an error and behaves as `enforce`.
# Read by every enforcing process (host, hub, gateway, edge-relay, taskiq-worker).
# TOOL_ACCESS_MODE=enforce
# Max concurrent MCP sessions per EDGE proxy (per-MCP `max_sessions` is separate and
# unchanged). Each session is a Node/Python process: size this against RAM.
# MAX_SESSIONS_EDGE=32

# Secrets & Session Encryption
SESSION_SECRET=your_random_session_secret_here
# ENCRYPTION_KEY=your_fernet_encryption_key_here  # Falls back to SESSION_SECRET if unset

# ==============================================================================
# Health Monitor & Circuit Breaker
# ==============================================================================
# Optional defaults; edit in Admin Dashboard -> Limits & Tuning.
# HEALTH_FAILURE_THRESHOLD=10    # Consecutive failures before tripping to Offline
# HEALTH_COOLDOWN_SECONDS=60     # Seconds to wait before attempting Half-Open probe

# ==============================================================================
# Workflow & Task Execution Limits
# ==============================================================================
# Optional defaults; edit in Admin Dashboard -> Limits & Tuning.
# MAX_RUN_OUTPUT_CHARS=32768     # Max stdout/stderr size stored in etcd (32 KB)
# MAX_RUN_ERROR_CHARS=4096       # Max error trace size stored in etcd (4 KB)
# TOOL_EXECUTION_TIMEOUT=300     # Seconds before a hub tool subprocess is killed
# WORKFLOW_RUN_TIMEOUT=3600      # Seconds a background-script container may run
# WORKFLOW_SLOT_WAIT_S=300       # Seconds a workflow waits for a free runner slot (429) before failing
# TOOL_SEARCH_LIMIT=8            # Max tools returned by search_tools
# FRAMEWORK_REGISTRY_REFRESH_TIMEOUT=5    # Bounded wait (s) for on-demand supervisor snapshot refresh
# FRAMEWORK_REGISTRY_SNAPSHOT_TTL=15      # Seconds between background supervisor snapshot refreshes

# ==============================================================================
# Agent Memory (Hindsight) & Semantic Search
# ==============================================================================
# Agent Memory (Hindsight). URL of the Hindsight server. In docker-compose this is set
# automatically to http://hindsight:8888. The feature is gated by the admin
# 'Agent Memory' feature flag (Admin Dashboard) and per-agent 'agent_memory: true' config.
HINDSIGHT_URL=http://hindsight:8888

# Which LLM Hindsight uses for fact extraction / reflection. Defaults to Gemini using the
# GEMINI_API_KEY at the top of this file — Hindsight is the ONLY consumer of that env var,
# since agent/rules/embeddings keys now live in the Admin UI (etcd). Override the model here
# (e.g. gemini-2.5-pro), or switch providers (provider one of: gemini, openai, anthropic,
# groq, ...) and set HINDSIGHT_LLM_API_KEY.
# HINDSIGHT_LLM_PROVIDER=gemini
# HINDSIGHT_LLM_MODEL=gemini-2.5-flash
# HINDSIGHT_LLM_API_KEY=                      # falls back to GEMINI_API_KEY if unset
# HINDSIGHT_EMBEDDINGS_PROVIDER=google        # provider for Gemini embeddings is "google", not "gemini"
# HINDSIGHT_EMBEDDINGS_MODEL=gemini-embedding-2   # multimodal; or gemini-embedding-001 (text-only)
# Output embedding dimension (Matryoshka). gemini-embedding-2 supports 128–3072
# (recommended 768 / 1536 / 3072) and auto-normalizes truncated dimensions.
# IMPORTANT: set this BEFORE first use — changing the model OR dimension later requires wiping
# the hindsight-data volume
# (`docker compose down && docker volume rm "$(basename "$PWD")_hindsight-data"`), or recall
# breaks on a mismatch. Do NOT use `down -v` — it also deletes the etcd-data volume.
# HINDSIGHT_EMBEDDINGS_DIMENSIONS=768
# Reranker. The slim image ships no local cross-encoder, so 'local' (the default) fails.
# Use 'rrf' (Reciprocal Rank Fusion passthrough — no neural rerank, no extra key/cost), or
# point at an API reranker (cohere / google-vertex / etc.) with its own credentials.
# HINDSIGHT_RERANKER_PROVIDER=rrf
# Semantic agent discovery (search_agents / auto_select). Agents are indexed at sync time
# using Gemini embeddings (model in Admin Dashboard -> Limits & Tuning; the Google key in
# Admin -> LLM Providers). If
# unavailable, search falls back to keyword matching. AGENT_SEARCH_LIMIT caps how many
# agents search_agents returns.
# Optional defaults; edit in Admin Dashboard -> Limits & Tuning.
# WARNING: changing AGENT_EMBEDDING_MODEL invalidates previously stored embeddings —
# re-embed agents (rebuild / registry sync) before semantic search works again.
# AGENT_SEARCH_LIMIT=8
# AGENT_EMBEDDING_MODEL=gemini-embedding-001

# ==============================================================================
# Authentication Providers (Optional)
# ==============================================================================
# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# OIDC OIDC
# OIDC_CLIENT_ID=your_oidc_client_id
# OIDC_CLIENT_SECRET=your_oidc_client_secret
# OIDC_METADATA_URL=https://your-idp.example.com/.well-known/openid-configuration

# Allowed Email Domains (comma-separated, leave blank for any domain)
ALLOWED_DOMAINS=

# Claim carrying identity-provider group membership, used by `group:` tool-authz
# rules (default: groups). Missing claim = no groups; never fails a login.
# OIDC_GROUPS_CLAIM=groups

# ==============================================================================
# Notifications & 3rd Party Integrations
# ==============================================================================
# 3rd-party credentials (e.g. SLACK_BOT_TOKEN) are NOT configured here. Store them
# as Tool Secrets in the UI (Configuration), which injects them into tool/workflow
# subprocesses at run time via the identity-scoped secret store. See docs/tools.md.

# ==============================================================================
# Container Runtime User (docker-compose only)
# ==============================================================================
# The app containers run as this uid:gid so files they write into the bind-mounted
# workspace/ (editor saves, marketplace adds, generated reports) are owned by you, not
# root. Set to your host user:  TRELLIS_UID=$(id -u)  TRELLIS_GID=$(id -g)
# Defaults to 1000:1000. After changing it, rebuild (`docker compose up -d --build`).
# If the health-data volume already exists root-owned, remove ONLY that volume and
# recreate (`docker compose down && docker volume rm "$(basename "$PWD")_health-data"`);
# do NOT use `down -v`, which also deletes the etcd-data volume (users, API keys,
# run history). Tool containers run as this uid:gid too, so they can write the
# workspace dirs they are mounted.
# TRELLIS_UID=1000
# TRELLIS_GID=1000

# ==============================================================================
# Service Topology (docker-compose sets these; needed for direct runs)
# ==============================================================================
# Internal service discovery. compose overrides HOST_URL/HUB_URL/REDIS_URL per
# container; set them here only when running a service directly (python core/*.py).
# ETCD_HOST=127.0.0.1
# ETCD_PORT=2379
# REDIS_URL=redis://localhost:6379/0
# HOST_URL=http://localhost:8000
# HUB_URL=http://localhost:8001/mcp

# ==============================================================================
# Rules Engine (Admin Dashboard -> Trellis Rules Engine)
# ==============================================================================
# The decider model/provider/base_url/timeout/confidence are configured in the admin
# UI and stored in etcd. These env vars are optional defaults used until an override
# is set (or when the etcd override lookup fails).
# RULES_EVALUATION_MODEL=gemini-2.5-flash
# RULES_EVALUATION_PROVIDER=            # any provider id from Admin -> LLM Providers (e.g. google)
# RULES_EVALUATION_BASE_URL=            # optional; only for providers that accept a custom endpoint
# RULES_EVALUATION_TIMEOUT=2.5
# RULES_CONFIDENCE_THRESHOLD=0.8

# ==============================================================================
# Gateway & SSL Configuration
# ==============================================================================
# Set to True/true to enable HTTPS. If true, you must provide certificates.
SSL_ENABLED=False

# The domain name to use in the Nginx server block (e.g., your-domain.com or localhost)
SSL_DNS_NAME=localhost

# Directory containing your SSL certificates (must contain cert.pem and key.pem)
# If using docker-compose, uncomment the volume mount in docker-compose.yml to use this.
# For an edge tunnel that must stay encrypted while :80 keeps serving plain HTTP, see
# deploy/tls/ (edge-only terminator); full runbook: docs/proxy-tls.md.
SSL_CERT_DIR=./gateway/ssl

# ==============================================================================
# Whitelabel & Branding
# ==============================================================================
# Edit these in the Admin Dashboard -> Branding. The APP_* vars below are only the
# built-in defaults a deployment may seed; an unset var falls back to the value shown.
# APP_NAME="Trellis"
# APP_FAVICON_URL=""
# APP_LOGO_URL=""
# APP_LOGIN_LOGO_URL=""
# APP_LOGIN_TITLE="Welcome Back"
# APP_LOGIN_SUBTITLE="Sign in to your workspace"
# APP_LOGIN_DISCLAIMER="This system is for authorized use only. All activities are monitored and logged for security and compliance purposes."
# APP_ACCENT_COLOR="#0055FF"
# APP_ACCENT_COLOR_DARK="#3377FF"
