# trellis-proxy configuration -- one file per edge node (engine 0.6.x).
#
# Copy to proxy.yaml next to this file's docker-compose.yml and edit. It is mounted
# read-only at /etc/trellis/proxy.yaml; the container paths below (`/etc/trellis/...`,
# `/app/workspace/...`) are the mounts the sample compose creates.
#
# ENROLLMENT TOKEN: never written here, only the name of the file or env var that
# holds it. See token_file: below.
#
# TOOL/MCP CREDENTIALS: two sources, neither one plaintext for a person.
#   * edge-secrets/<item>.env -- one shared service account per exported item.
#   * browser-sealed per-user sets -- entered in the central UI, stored there as
#     ciphertext, opened here with the edge key (EDGE_PRIVATE_KEY_PATH). There is no
#     per-user file and no `trellis-proxy user-secrets` command any more.
# Since 0.5.0 a child process receives only the keys its manifest DECLARES --
# `secrets`, `optional_secrets`, `variables` and the field keys of `secret_groups` in
# tool.yaml / mcp.yaml. An undeclared process environment variable is invisible to the
# tool; the tunnel token and the framework's own control-plane secrets are stripped in
# every mode.
#
# RELOAD: SIGHUP (`docker kill -s HUP trellis-proxy`) re-reads this file and
# re-publishes the catalog (the proxy reconnects; in-flight calls fail rather than
# being replayed).
#   live-reloadable: exports, export_mcps, tools_dir, mcps_dir, lazy_catalog
#   restart-required: site, server_url, token_env, token_file, tls_*,
#     env_passthrough, and the secrets_dir *path* -- for each one you try to apply with
#     SIGHUP the proxy logs a warning and keeps the current value
# Credential *contents* are a third case: tool calls read them every time (the sealed
# set arrives with the call), while MCP sessions resolve credentials once at creation,
# so a SIGHUP retires every live session and the next call reopens it. Moving the
# shared directory is a path change, i.e. a restart.

# Site id, pre-registered by an admin in Admin -> Edges. It must match the site the
# token was issued for. The central relay derives identity from the token hash and never
# trusts this value, so a wrong site cannot impersonate another edge -- the proxy logs a
# warning when the relay reports a different site than the one configured here.
# Odd chars are refused at load: it becomes half of every `<site>__<tool>` registry name.
# Env equivalent: TRELLIS_EDGE_SITE.
site: dc1

# Central Trellis host, WebSocket endpoint. Use wss:// in production: the tunnel carries
# the bearer token and internal tool arguments. The path is fixed.
#
# The proxy verifies the relay's certificate and has no switch to disable that. For an
# internal CA point tls_ca_file at the CA (see docs/proxy-tls.md).
# Env equivalent: TRELLIS_SERVER_URL.
server_url: wss://trellis.example.com/edge/v1/connect

# Where the enrollment token (edge_<site>_<random>) is read from. The file form is
# preferred: it is not part of the process environment, so it never lands in
# /proc/<pid>/environ where a tool could read it. The sample compose mounts it as a
# docker secret. The proxy reads the file once and unlinks it when the mount allows it.
# Env equivalent: TRELLIS_EDGE_TOKEN_FILE.
token_file: /run/secrets/edge_token

# Fallback for installs that cannot mount a file: name of the env var holding the token
# (used only when token_file is absent). Never inline the token itself: this file is
# read-only inside the container but still copied by backups.
# token_env: TRELLIS_EDGE_TOKEN

# ---------------------------------------------------------------- tools
#
# Directory holding this edge's tool.yaml directories. Same schema as the central
# workspace (workspace/tools/<tool>/tool.yaml). The sample compose mounts the workspace
# at /app/workspace read-write because exported tools may write there; mount :ro only
# when every tool is read-only.
# Each call runs in a runner container that gets this suite mounted READ-ONLY plus
# `shared/` read-only; output dirs are granted one at a time via `output_dirs`.
# Env equivalent: TRELLIS_EDGE_TOOLS_DIR.
tools_dir: ./workspace/tools

# Allowlist of tools this node publishes to central. Empty list publishes NOTHING --
# this is an allowlist, not a denylist. An unlisted tool is never advertised, and the
# proxy refuses it locally even if central asks, so a compromised relay cannot invoke
# an unexported tool.
#
# Two forms:
#   - bare name                        -> credential_mode: shared (the default)
#   - {name, credential_mode} mapping  -> that tool's credential policy
# Modes: shared | per_user | per_user_required (see "Credential modes" below).
exports:
  # Stateless tool, no credentials of its own: reads the edge service account.
  - boiler_status
  # Python CLI wrappers (stdin/stdout tool protocol) whose tool.yaml declares its keys
  # through `secret_groups` (one group per target environment: staging | production).
  # Each operator seals their own set in the central UI before this works; without
  # one, `per_user` falls back to the shared file, then the process env.
  - name: node_ssh
    credential_mode: per_user
  - name: node_file_transfer
    credential_mode: per_user

# ---------------------------------------------------------------- MCP servers
#
# Directory holding this edge's mcp.yaml directories (workspace/mcps/<mcp>/mcp.yaml,
# same MCPConfig schema as central). Nothing here is connected from the central side:
# the edge publishes each tool's inputSchema verbatim and executes tools/call locally.
# Env equivalent: TRELLIS_EDGE_MCPS_DIR.
mcps_dir: ./workspace/mcps

# Allowlist of MCP servers this node publishes. Same two forms as `exports`, plus the
# per-server policy an MCP needs:
#   include_tools         publish only these tool names (empty = all of them)
#   exclude_tools         never publish/serve these names, even if listed above
#   credential_mode       shared | per_user | per_user_required
#   session_ttl_minutes   idle TTL before a user's server process is retired (30)
#   max_sessions          concurrent sessions for this server (8; 32 per edge)
#
# Sessions are keyed per (mcp, user identity) -- one long-lived server process and one
# HOME/TMPDIR per user -- so login state survives calls and tunnel reconnects and never
# crosses between users. A dead session is reported in that call's result
# (`mcp_session_lost`) and restarted lazily on the next one; no call is ever replayed.
export_mcps:
  # Operational CLI MCP server: stdio, Node, keeps its login session in files under
  # HOME. Its mcp.yaml declares an explicit `tools:` catalog (8 category meta-tools with
  # top-level oneOf schemas), so publishing needs no live discovery.
  # per_user_required: no sealed set for the caller = fail closed with
  # `no credentials for <email> on edge dc1`, nothing is spawned.
  - name: devops-cli
    include_tools:
      - tenant_account_tools
      - tenant_network_tools
      - node_power_tools
      - list_actions
    exclude_tools:
      # Read-only audit view is fine centrally; the destructive reset is not.
      - tenant_admin_tools
    credential_mode: per_user_required
    session_ttl_minutes: 30
    max_sessions: 8
  # Bare form: shared credentials, default session settings.
  - coralogix

# ---------------------------------------------------------------- credentials
#
# The shared credential store. It must live OUTSIDE the tool-writable workspace: tool
# code runs as this uid and can read whatever the workspace exposes, so a store inside
# it would hand every exported tool every other item's secrets.
#
#   secrets_dir       <tool-or-mcp>.env per exported item (one service account)
#
# Default is ./edge-secrets; the sample compose bind-mounts it at the path below.
# Files are mode 0600, directories 0700, and nothing here is ever sent to central or
# stored in etcd.
# Env equivalent: TRELLIS_EDGE_SECRETS_DIR.
#
# PER-USER CREDENTIALS ARE NOT A FILE ANY MORE. A user enters them in the central UI
# (Configuration -> Edge credentials); the browser encrypts them to this edge's public
# key, central stores only the envelope, and the proxy opens it with the private key at
# EDGE_PRIVATE_KEY_PATH (default /etc/trellis/edge-key, mounted 0400 into this service
# only). `trellis-proxy edge-keygen` creates it; `--show` prints the public
# fingerprint; `--rotate` keeps the old key as `edge-key.old` for the overlap window and
# `--drop-old-key` ends it. Losing the key means every user re-enters their set -- there
# is no recovery, by design. The old `edge-user-secrets/` directory and the
# `user-secrets` command were removed in 0.6.
secrets_dir: /etc/trellis/edge-secrets
#
# Credential modes, resolved per declared key:
#   shared             edge-secrets/<name>.env -> process env -> unset
#   per_user           the caller's sealed set if present; else shared -> process env
#   per_user_required  the caller's sealed set ONLY; nothing sealed for them refuses
#                      the call (`missing_credentials`) before anything runs
# A sealed set is ALL-OR-NOTHING for secrets: a declared secret it omits stays missing
# and is never filled from the shared file or the process env. `variables` (endpoints)
# always come from this edge's shared file / process env, never from a sealed set.
# An empty value (`KEY=`) in the shared file counts as unset, so a blank template line
# cannot blank a working credential.
#
# One shared file per item, `/etc/trellis/edge-secrets/devops-cli.env`
# (comments must be on their own line: a trailing `#` becomes part of the value):
#   DEVOPS_URL=https://devops.internal
#   DEVOPS_USERNAME=svc-edge
#   DEVOPS_PASSWORD=...
#   CORALOGIX_API_KEY=...
# The last key is optional_secrets in mcp.yaml.
# Per-user files are gone; a user's set is entered once at
#   Configuration -> Edge credentials -> devops-cli
# and re-entered after a key rotation retires the old one.

# ---------------------------------------------------------------- environment
#
# 0.5.0 gives a child process an allowlist base env (PATH, HOME, LANG, TZ, TMPDIR, the
# proxy vars, LC_*, TRELLIS_*) plus only the keys its manifest declares. Set this to
# true ONLY for a legacy tool that cannot declare every key it reads: it restores the
# v0.4 "whole sanitized environment" behaviour (the tunnel token and framework secrets
# are still stripped). Costs you the isolation between tools.
# Env equivalent: TRELLIS_EDGE_ENV_PASSTHROUGH=true.
env_passthrough: false

# ---------------------------------------------------------------- lazy catalog
#
# Publish tools as name + a short summary (<=120 chars) instead of shipping every
# input schema in the hello frame; central fetches a full schema on demand over the
# same tunnel (describe_tool / search_tools detail) and caches it. Requires a relay
# from v0.7 or newer -- an older relay rejects the `lazy_catalog` capability and the
# edge cannot connect, so leave this off until central is upgraded.
# Default: false (full catalogs, byte-identical to pre-0.7).
lazy_catalog: false

# ---------------------------------------------------------------- runner
#
# Every tool call and stdio MCP session runs in its own gVisor (runsc) container
# created by the edge `runner` service in docker-compose.yml, reached over
# `runner_socket` below. The runner is the ONLY execution path since v0.7.1 -- the
# legacy in-process backends (bwrap, Landlock) are gone, and there is no `sandbox:`
# setting any more (an older proxy.yaml that still carries one is accepted, the key
# ignored with a single warning). It requires that service to
# be up, runsc registered with the edge's Docker daemon, and the runner pointed at
# this host's workspace path via TRELLIS_HOST_WORKSPACE (see docs/proxy.md ->
# "Edge runner"). A dev machine without gVisor sets CONTAINER_DEFAULT_RUNTIME=runc
# on the runner service.
#
# Unix socket of the runner control API, shared with the runner container through the
# `proxy-runner` volume.
# Env equivalent: RUNNER_SOCKET.
runner_socket: /run/trellis/runner.sock
#
# Session/tool resource use is sized by the manifest's `limits:` block (cgroup v2 on
# the runner container), not by environment variables.

# ---------------------------------------------------------------- mutual TLS
#
# Optional. Only needed when the central relay is configured with EDGE_MTLS_CA. Mount
# the files read-only into this container; the proxy presents the certificate on the
# WebSocket handshake and verifies the relay against tls_ca_file. The key pair must be
# set together, and all three require a wss:// server_url.
# Env equivalents: TRELLIS_EDGE_TLS_CA / _CERT / _KEY.
# tls_ca_file: /etc/trellis/tls/ca.pem
# tls_cert_file: /etc/trellis/tls/edge.pem
# tls_key_file: /etc/trellis/tls/edge-key.pem

# ---------------------------------------------------------------- what the manifests look like
#
# These live in workspace/mcps/<name>/mcp.yaml and workspace/tools/<name>/tool.yaml; they
# are NOT read from this file. They are here to show what `per_user_required` and
# `secret_groups` need on the other side of the pointer.
#
# workspace/mcps/devops-cli/mcp.yaml
#   name: devops-cli
#   transport: stdio
#   command: node
#   args: [/opt/devops-cli-mcp/dist/index.js]
#   network: egress                # stdio net policy: egress (default) | none
#   secrets: [DEVOPS_URL, DEVOPS_USERNAME, DEVOPS_PASSWORD]
#   optional_secrets: [CORALOGIX_API_KEY]
#   variables: [CORALOGIX_DOMAIN]
#   tools:                         # explicit catalog: no live discovery at publish time
#     - name: tenant_account_tools
#       description: Tenant accounts -- create, read, update, list.
#       inputSchema:               # published and delivered VERBATIM
#         type: object
#         oneOf:
#           - type: object
#             properties:
#               action: {const: get_account}
#               params: {type: object}
#             required: [action]
#           - type: object
#             properties:
#               action: {const: list_accounts}
#             required: [action]
#     - name: list_actions
#       description: List every action this meta-tool accepts.
#       inputSchema: {type: object}
#
# workspace/tools/node_ssh/tool.yaml
#   name: node_ssh
#   runtime: python
#   entrypoint: node_ssh.py        # stdin JSON -> stdout JSON, no argv
#   description: Run a command on a backbone node over SSH.
#   timeout_seconds: 120
#   retry_on_transient: false      # non-idempotent/high-privilege: never re-execute
#   secret_groups:                 # every field key below is a DECLARED key on the edge
#     - label: Target environment
#       select_label: Environment
#       options:
#         - value: production
#           label: Production backbone
#           fields:
#             - {key: PROD_NODE_SSH_USER, label: SSH user, type: text}
#             - {key: PROD_NODE_SSH_PASSWORD, label: Password, type: password}
#         - value: staging
#           label: Staging backbone
#           fields:
#             - {key: STAGING_NODE_SSH_USER, label: SSH user, type: text}
#             - {key: STAGING_NODE_SSH_PASSWORD, label: Password, type: password}
