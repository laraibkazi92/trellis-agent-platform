# AppArmor profile for the Trellis tool-hub container.
#
# Generated from Docker's docker-default profile
# (github.com/moby/profiles, apparmor/template.go) with three rule changes:
#
#   1. docker-default's `deny mount,` is removed. The hub's bwrap backend needs
#      bind mounts (`/` read-only, `/app/workspace` read-write), a fresh procfs
#      and a tmpfs on `/tmp`. AppArmor is a whitelist: removing the deny is not
#      enough, so `mount,` is added below. Without it every tool call fails with
#      "bwrap: Can't bind mount ...: Permission denied" (AppArmor is independent
#      of seccomp, which is why `seccomp=unconfined` alone does not help).
#   2. `pivot_root,` is added. After building the new root, bwrap calls
#      pivot_root(2), which AppArmor mediates as its own rule class. Kernels
#      without pivot_root mediation ignore the rule; the parser accepts it on
#      older userspace too (verified against apparmor_parser 3.0.4).
#   3. `userns,` is added. bwrap creates an unprivileged user namespace
#      (`--unshare-user`) that maps the hub's operator uid 1:1. The profile
#      pins ABI 4.0 (below) so this rule is mediated: on hosts with
#      `kernel.apparmor_restrict_unprivileged_userns=1` (Ubuntu 24.04+) an
#      unconfined container is refused, while this profile grants the
#      permission bwrap needs.
#
# `mount,` and `pivot_root,` are relaxations, but bounded by the kernel: the
# hub container has no capabilities (`cap_drop: ALL`), so mount(2) and
# pivot_root(2) are only honoured inside a user namespace the process created
# itself — the same permission an unprivileged user has on a bare host.
#
# The `apparmor` job in .github/workflows/sandbox-smoke.yml is the validation of
# record: it loads this profile on an Ubuntu 24.04 runner VM (AppArmor enforcing,
# Docker's docker-default active, `apparmor_restrict_unprivileged_userns=1`) and
# runs the full sandbox smoke harness with bwrap, then with the Landlock
# fallback.

#
# Install this profile on the HOST and load it there -- AppArmor profiles are
# applied by the host kernel, not from inside the container:
#
#   sudo install -m 0644 deploy/apparmor/trellis-hub /etc/apparmor.d/trellis-hub
#   sudo apparmor_parser -r /etc/apparmor.d/trellis-hub
#
# Then select it for the hub in a compose override (or the hub block):
#
#   services:
#     hub:
#       security_opt:
#         - "apparmor=trellis-hub"
#
# This profile is the alternative for orgs that forbid `apparmor=unconfined`.
# It is not needed, and is never loaded, when the hub runs with
# `apparmor=unconfined`.
#
# `userns,` needs an AppArmor parser that knows the rule and an ABI that
# mediates it (this profile pins 4.0). On older userspace -- Ubuntu 22.04's
# 3.0.4 rejects the profile with a syntax error -- this file cannot be used;
# 22.04 has no unprivileged-userns restriction, so `apparmor=unconfined` is the
# supported posture there.
#
# This profile is NOT a hardening win over docker-default: it only replaces the
# mount denial bwrap needs with an allow and adds pivot_root. It is the
# policy-compliance alternative for orgs that forbid `apparmor=unconfined`.

# ABI 4.0 adds mediated user namespaces (`userns,` below) and changes `network,`
# to internet sockets only, so unix-domain sockets need their own rule. The
# include path must be `abi/4.0` (under /etc/apparmor.d); a bare `<4.0>`
# does not resolve and apparmor_parser refuses to load the profile.
abi <abi/4.0>,

#include <tunables/global>

profile trellis-hub flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  # At ABI >= 4 `network,` no longer covers unix-domain sockets.
  unix,
  # Disallow obsolete socket families removed from the Linux kernel.
  # AF_DECnet has no AppArmor family name, so it cannot be denied here.
  deny network ax25,
  deny network ipx,
  deny network appletalk,
  deny network netrom,
  deny network rose,
  deny network econet,
  deny network atmsvc,
  deny network irda,
  deny network wanpipe,
  deny network isdn,
  deny network caif,
  # Disallow AF_ALG (Linux kernel crypto API); see https://copy.fail/
  deny network alg,
  # Disallow AF_VSOCK to prevent host/guest communication.
  deny network vsock,
  capability,
  file,
  umount,
  # bwrap's mounts: bind mounts of / and /app/workspace, tmpfs on /tmp and
  # /dev, and a fresh proc. docker-default denies this with `deny mount,`;
  # this profile replaces that deny with an allow.
  mount,
  # bwrap's final step into the new root; AppArmor mediates pivot_root(2)
  # separately from mount rules.
  pivot_root,
  # bwrap --unshare-user: unprivileged user namespace for the tool. Mediated at
  # the pinned ABI 4.0; this is what lifts Ubuntu's unprivileged-userns
  # restriction for the hub.
  userns,

  # Host (privileged) processes may send signals to container processes.
  signal (receive) peer=unconfined,
  # runc may send signals to container processes (for "docker stop").
  signal (receive) peer=runc,
  # crun may send signals to container processes (for "docker stop" when used with crun OCI runtime).
  signal (receive) peer=crun,
  # dockerd may send signals to container processes (for "docker kill").
  signal (receive) peer=docker-default,
  # Container processes may send signals amongst themselves.
  signal (send,receive) peer="trellis-hub",

  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  # deny write to files not in /proc/<number>/** or /proc/sys/**
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,  # deny /proc/sys except /proc/sys/k* (effectively /proc/sys/kernel)
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # allow processes within the container to trace each other,
  # provided all other LSM and yama setting allow it.
  ptrace (trace,tracedby,read,readby) peer="trellis-hub",
}
