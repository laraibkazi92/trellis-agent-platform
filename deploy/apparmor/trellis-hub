# AppArmor profile for the Trellis tool-hub container.
#
# Generated from Docker's docker-default profile
# (github.com/moby/profiles, apparmor/template.go) with two rule changes:
#
#   1. `deny mount,` is removed. The hub's bwrap backend needs bind mounts
#      (`/` read-only, `/app/workspace` read-write), a fresh procfs and a tmpfs
#      on `/tmp`, then calls pivot_root to enter that root. docker-default
#      denies the first of those mounts, so every tool call fails with
#      "bwrap: Can't bind mount ...: Permission denied". AppArmor is
#      independent of seccomp, which is why `seccomp=unconfined` alone does not
#      help.
#   2. `userns,` is added. bwrap creates a user namespace (`--unshare-user`);
#      on hosts with `kernel.apparmor_restrict_unprivileged_userns=1`
#      (Ubuntu 24.04+), a confined profile without this rule is refused and
#      surfaces as "bwrap: setting up uid map: Permission denied".
#
# Install this profile on the HOST and load it there -- AppArmor profiles are
# applied by the host kernel, not from inside the container:
#
#   sudo install -m 0644 deploy/apparmor/trellis-hub /etc/apparmor.d/trellis-hub
#   sudo apparmor_parser -r /etc/apparmor.d/trellis-hub
#
# Then select it for the hub in a compose override (or the hub block):
#
#   services:
#     hub:
#       security_opt:
#         - "apparmor=trellis-hub"
#
# This profile is the alternative for orgs that forbid `apparmor=unconfined`.
# It is not needed, and is never loaded, when the hub runs with
# `apparmor=unconfined`.
#
# `userns,` needs an AppArmor parser with user-namespace mediation (upstream
# 4.0+, or Ubuntu's 3.0.7+ backport). On older userspace, delete that one rule:
# those kernels have no AppArmor userns restriction for it to lift.
#
# This profile is NOT a hardening win over docker-default: it only removes the
# mount denial bwrap needs and lifts the userns restriction. It is the
# policy-compliance alternative for orgs that forbid `apparmor=unconfined`.

# Match docker-default's explicit ABI: at ABI >= 4, `network,` no longer
# includes unix-domain sockets (moby/profiles pins 3.0 for this reason).
abi <3.0>,

#include <tunables/global>

profile trellis-hub flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  # Disallow obsolete socket families removed from the Linux kernel.
  # AF_DECnet has no AppArmor family name, so it cannot be denied here.
  deny network ax25,
  deny network ipx,
  deny network appletalk,
  deny network netrom,
  deny network rose,
  deny network econet,
  deny network atmsvc,
  deny network irda,
  deny network wanpipe,
  deny network isdn,
  deny network caif,
  # Disallow AF_ALG (Linux kernel crypto API); see https://copy.fail/
  deny network alg,
  # Disallow AF_VSOCK to prevent host/guest communication.
  deny network vsock,
  capability,
  file,
  umount,
  # bwrap --unshare-user: required where AppArmor restricts unprivileged
  # user namespaces (Ubuntu 24.04+).
  userns,

  # Host (privileged) processes may send signals to container processes.
  signal (receive) peer=unconfined,
  # runc may send signals to container processes (for "docker stop").
  signal (receive) peer=runc,
  # crun may send signals to container processes (for "docker stop" when used with crun OCI runtime).
  signal (receive) peer=crun,
  # dockerd may send signals to container processes (for "docker kill").
  signal (receive) peer=docker-default,
  # Container processes may send signals amongst themselves.
  signal (send,receive) peer="trellis-hub",

  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  # deny write to files not in /proc/<number>/** or /proc/sys/**
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,  # deny /proc/sys except /proc/sys/k* (effectively /proc/sys/kernel)
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # allow processes within the container to trace each other,
  # provided all other LSM and yama setting allow it.
  ptrace (trace,tracedby,read,readby) peer="trellis-hub",
}
