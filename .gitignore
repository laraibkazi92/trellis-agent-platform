*pycache*
.env

# Per-deployment compose override (see docker-compose.workspace-example.yml) --
# local, never committed. Compose auto-loads any of these override names.
docker-compose.override.yml
docker-compose.override.yaml
compose.override.yml
compose.override.yaml

data/

.git_local_credentials

workspace/reports/
*.playwright*

# Host-installed CLI binaries — placed directly on the host into each tool's own
# bin/ (e.g. workspace/tools/<tool>/bin/<binary>), never committed. See
# core/hub.py's per-tool PATH injection.
workspace/tools/*/bin/

.DS_Store
.venv/
.codegraph

# Cleanup audit artifacts (scratch reports, safe to regenerate)
__cleanup_reports/